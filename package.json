{
  "name": "gudangai-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/assemble-api.mjs && node scripts/write-icons.mjs && node scripts/write-sw-version.mjs && vite build && node -e \"require('node:fs').rmSync('dist/_redirects',{force:true})\"",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:agent": "node --test scripts/test-agent-worker.mjs",
    "test:dates": "node --test scripts/test-tanggal.mjs",
    "preview": "vite preview",
    "write-icons": "node scripts/write-icons.mjs",
    "predev": "node scripts/assemble-api.mjs && node scripts/write-icons.mjs",
    "assemble-api": "node scripts/assemble-api.mjs"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^26.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vitest": "^3.2.4"
  }
}

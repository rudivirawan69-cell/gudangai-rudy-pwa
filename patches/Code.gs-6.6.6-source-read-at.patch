+// Attach an Apps Script source-read timestamp only to successful read responses.
+// This timestamp is generated after the underlying read action returns; it is
+// never synthesized by the Worker/gateway and is never added to write actions.
+function withSourceReadAt_(result) {
+  if (!result || typeof result !== "object" || Array.isArray(result)) {
+    return { success: false, code: "INVALID_READ_RESPONSE", error: "Respons baca tidak valid." };
+  }
+  if (result.success !== true) return result;
+  if (!result.sourceReadAt) result.sourceReadAt = new Date().toISOString();
+  return result;
+}

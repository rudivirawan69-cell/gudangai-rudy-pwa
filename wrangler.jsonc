{// wrangler.jsonc
"name": "gudangai-rudy-pwa",
  "compatibility_date": "2026-10-04",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "GUDANGAI_SHEETS_API_URL": "https://script.google.com/macros/s/AKfycbxYNipdWCeg1800-D4iA0ZDtO0Yy9RxQ0hcjZfJNO15mU0bSjSS6KiwkbSzcbJYhg8VIA/exec",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "ANTHROPIC_FALLBACK_ENABLED": "false",
    "ALLOWED_ORIGINS": "https://gudangai-rudy.rudivirawan69.workers.dev,https://rudivirawan69-cell.github.io,https://gudangai-rudy-pwa.vercel.app,https://gudangai-rudy-pwa-live.vercel.app"
  },
  "previews": {}
}

{
  "name": "gudangai-rudy-pwa69",
  "main": "cloudflare/gateway-worker.js",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "ai": {
    "binding": "AI"
  },
  "services": [
    {
      "binding": "CLAUDE_PROXY",
      "service": "claude-proxy"
    }
  ],
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "ALLOWED_ORIGINS": "https://gudangai-rudy-pwa69.rudivirawan69.workers.dev,https://rudivirawan69-cell.github.io,https://gudangai-rudy-pwa-live.vercel.app"
  }
}

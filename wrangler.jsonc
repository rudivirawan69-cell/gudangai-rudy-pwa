{
  "name": "gudangai-rudy",
  "compatibility_date": "2026-10-04",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "SUPABASE_URL": "https://cbeosysruwkfwgklziog.supabase.co",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "ANTHROPIC_FALLBACK_ENABLED": "false",
    "ALLOWED_ORIGINS": "https://gudangai-rudy.rudivirawan69.workers.dev,https://gudangai-rudy-pwa.vercel.app"
  },
  "previews": {}
}
